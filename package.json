{
  "name": "wattcade",
  "private": true,
  "description": "Small arcade games you play by pedalling an indoor smart trainer: power and cadence as the controller, FTMS over Web Bluetooth, with a keyboard fallback.",
  "keywords": [
    "indoor-cycling",
    "smart-trainer",
    "ftms",
    "web-bluetooth",
    "cycling",
    "browser-game"
  ],
  "homepage": "https://github.com/ryanchard/wattcade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanchard/wattcade.git"
  },
  "bugs": {
    "url": "https://github.com/ryanchard/wattcade/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm --workspace @paperboy/arcade run dev",
    "build": "npm --workspace @paperboy/arcade run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.20",
    "happy-dom": "^20.14.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
